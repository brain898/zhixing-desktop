# 知行有策 后端配置示例
# 复制此文件并重命名为 .env，填入真实的 DeepSeek API Key 即可自动生效

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_EXTRACT_BATCH_MAX_BLOCKS=8
DEEPSEEK_EXTRACT_BATCH_MAX_CHARS=9000
DEEPSEEK_EXTRACT_BATCH_OVERLAP=1

# Jev 分类与语义质检（默认关闭，不会对既有知识库自动发起调用）
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=30
JEV_MAX_RETRIES=2
JEV_QUESTION_DEFINITION_VERSION=zhixing-jev-v1
# 仅用于人工审核排序，尚未经过业务样本校准
JEV_REVIEW_HIGH_PROBABILITY=0.65
JEV_REVIEW_MEDIUM_PROBABILITY=0.45

# 服务监听配置
SERVER_HOST=127.0.0.1
SERVER_PORT=8766

# 环境与浏览器来源。正式环境默认不创建任何演示账号。
ZHIXING_ENV=production
ZHIXING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
ZHIXING_ENABLE_DEMO_SEED=false

# 仅隔离演示环境需要。启用演示数据时必须自行设置，不提供默认密码。
ZHIXING_DEMO_ADMIN_PASSWORD=
ZHIXING_DEMO_MEMBER_PASSWORD=
ZHIXING_DEMO_OTHER_PASSWORD=
